{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flow",
  "scopeName": "source.flow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#bend-declarations" },
    { "include": "#flow-declarations" },
    { "include": "#constructors" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.number-sign.flow", "match": "#.*$" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flow",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.flow", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.flow",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.flow", "match": "\\\\." }]
        }
      ]
    },
    "bend-declarations": {
      "patterns": [
        {
          "match": "\\b(def|law)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.flow" },
            "2": { "name": "entity.name.function.flow" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.flow" },
            "2": { "name": "entity.name.type.flow" }
          }
        }
      ]
    },
    "flow-declarations": {
      "patterns": [
        {
          "match": "^(\\s*)([+\\-~]?)([A-Za-z_][A-Za-z0-9_.]*)(?=\\s*(?:<[^>]*>)?\\s*\\()",
          "captures": { "2": { "name": "storage.modifier.quantity.flow" }, "3": { "name": "entity.name.function.flow" } }
        },
        {
          "match": "^(\\s*)([+\\-~]?)([A-Z][A-Za-z0-9_.]*)(?=\\s*(?:<[^>]*>)?\\s*:)",
          "captures": { "2": { "name": "storage.modifier.quantity.flow" }, "3": { "name": "entity.name.type.flow" } }
        },
        {
          "match": "^(\\s*)([+\\-~]?)([A-Za-z_][A-Za-z0-9_.]*)(?=\\s*:)",
          "captures": { "2": { "name": "storage.modifier.quantity.flow" }, "3": { "name": "variable.other.definition.flow" } }
        }
      ]
    },
    "constructors": {
      "patterns": [
        { "name": "entity.name.type.constructor.flow", "match": "(?<=\\|\\s)[A-Za-z_][A-Za-z0-9_.]*(?=\\s*\\{)" },
        { "name": "entity.name.function.constructor.flow", "match": "\\b[A-Za-z_][A-Za-z0-9_.]*(?=(?:<[^>]+>)?\\s*\\{)" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.flow", "match": "\\b(?:match|case|do|return|for|exs|where)\\b" },
        { "name": "keyword.declaration.flow", "match": "\\b(?:def|law|type|is|import|as)\\b" },
        { "name": "storage.modifier.flow", "match": "@unsafe\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.flow", "match": "\\b(?:Type|Data|Kind|Quant)\\b" },
        { "name": "support.type.flow", "match": "\\b(?:Nat|U32|F32|String|Bool)\\b" },
        { "name": "entity.name.type.flow", "match": "\\b[A-Z][A-Za-z0-9_.]*\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.flow", "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.nat.flow", "match": "\\b[0-9]+n\\b" },
        { "name": "constant.numeric.flow", "match": "\\b[0-9]+\\b" }
      ]
    },
    "operators": {
      "patterns": [{ "name": "keyword.operator.flow", "match": "==|!=|<=|>=|->|=>|<-|[-+*/%<>=&|!@~]" }]
    }
  }
}
